APP_NAME=Dumphere
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
TRUSTED_PROXIES=127.0.0.1

CONTACT_EMAIL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=md_editor
DB_USERNAME=md_editor
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

YJS_WS_SECRET=
YJS_ALLOWED_ORIGINS=http://localhost:8000
YJS_WS_PUBLIC_URL=ws://localhost:1234
YJS_MAX_CONNECTIONS_PER_IP=10
YJS_MAX_MESSAGES_PER_SECOND=30
YJS_MAX_MESSAGE_BURST=120
YJS_MAX_PAYLOAD_BYTES=1048576
YJS_MAX_DOCUMENT_BYTES=2097152
YJS_TRUST_PROXY=false
YJS_TRUSTED_PROXIES=127.0.0.1,::1

RESERVED_PREFIX_MAX_DOCUMENTS=50

VITE_APP_NAME="${APP_NAME}"
VITE_YJS_WS_HOST=localhost
VITE_YJS_WS_PORT=1234
VITE_YJS_WS_SCHEME=ws
VITE_YJS_WS_PATH=

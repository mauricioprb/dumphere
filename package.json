{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^24.0.0",
        "npm": ">=11.0.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint . --fix",
        "lint:test": "eslint .",
        "format": "prettier --write .",
        "format:test": "prettier --check .",
        "check": "npm run lint:test && npm run format:test && npm run type-check && npm test && npm run build",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,mjs,ts,vue}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{css,json,jsonc,md,yml,yaml,html}": [
            "prettier --write"
        ],
        "*.php": [
            "vendor/bin/pint"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "concurrently": "^10.0.4",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "laravel-vite-plugin": "^3.1.3",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.10",
        "vue-eslint-parser": "^10.4.1",
        "vue-tsc": "^3.3.9"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.6.1",
        "@lucide/vue": "^1.28.0",
        "@tiptap/extension-character-count": "^3.30.5",
        "@tiptap/extension-code-block-lowlight": "^3.30.5",
        "@tiptap/extension-collaboration": "^3.30.5",
        "@tiptap/extension-collaboration-caret": "^3.30.5",
        "@tiptap/extension-highlight": "^3.30.5",
        "@tiptap/extension-image": "^3.30.5",
        "@tiptap/extension-link": "^3.30.5",
        "@tiptap/extension-placeholder": "^3.30.5",
        "@tiptap/extension-subscript": "^3.30.5",
        "@tiptap/extension-superscript": "^3.30.5",
        "@tiptap/extension-table": "^3.30.5",
        "@tiptap/extension-task-item": "^3.30.5",
        "@tiptap/extension-task-list": "^3.30.5",
        "@tiptap/extension-typography": "^3.30.5",
        "@tiptap/extension-underline": "^3.30.5",
        "@tiptap/pm": "^3.30.5",
        "@tiptap/starter-kit": "^3.30.5",
        "@tiptap/suggestion": "^3.30.5",
        "@tiptap/vue-3": "^3.30.5",
        "@tiptap/y-tiptap": "^3.0.8",
        "lowlight": "^3.3.0",
        "pinia": "^4.0.2",
        "tippy.js": "^6.3.7",
        "tiptap-markdown": "^0.9.0",
        "vue": "^3.5.40",
        "y-indexeddb": "^9.0.12",
        "y-websocket": "^3.0.0",
        "yjs": "^13.6.31"
    }
}

[Unit]
Description=Dumphere Yjs collaboration server
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=www-data
WorkingDirectory=/var/www/dumphere/current/yjs-server
EnvironmentFile=/var/www/dumphere/shared/.env
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ReadWritePaths=/var/www/dumphere/shared
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dumphere-yjs

[Install]
WantedBy=multi-user.target

[Unit]
Description=Dumphere encrypted PostgreSQL backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=www-data
WorkingDirectory=/var/www/dumphere/current
EnvironmentFile=/var/www/dumphere/shared/.env
ExecStart=/var/www/dumphere/current/scripts/backup-postgres.sh
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/dumphere
StandardOutput=journal
StandardError=journal
SyslogIdentifier=dumphere-backup

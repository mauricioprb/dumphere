APP_NAME=Dumphere
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://editor.example.com
TRUSTED_PROXIES=127.0.0.1

CONTACT_EMAIL=contato@editor.example.com

LOG_CHANNEL=stderr
LOG_LEVEL=warning
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=md_editor
DB_USERNAME=md_editor
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local

YJS_WS_SECRET=
HOST=127.0.0.1
YJS_ALLOWED_ORIGINS=https://editor.example.com
YJS_WS_PUBLIC_URL=wss://editor.example.com/yjs-ws
YJS_MAX_CONNECTIONS_PER_IP=10
YJS_MAX_MESSAGES_PER_SECOND=30
YJS_MAX_MESSAGE_BURST=120
YJS_MAX_PAYLOAD_BYTES=1048576
YJS_MAX_DOCUMENT_BYTES=2097152
YJS_TRUST_PROXY=true
YJS_TRUSTED_PROXIES=127.0.0.1,::1

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BRL=
STRIPE_PRICE_USD=
STRIPE_ACCESS_YEARS=100

VITE_APP_NAME=Dumphere
VITE_YJS_WS_HOST=
VITE_YJS_WS_PORT=
VITE_YJS_WS_SCHEME=
VITE_YJS_WS_PATH=

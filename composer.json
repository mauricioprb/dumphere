{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mauricioprb/dumphere",
    "type": "project",
    "description": "Public collaborative Markdown editor where the URL path is the document.",
    "keywords": ["markdown", "editor", "collaborative", "crdt", "yjs"],
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^13.0",
        "symfony/html-sanitizer": "^8.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.24",
        "laravel/tinker": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@services",
            "@php artisan migrate --force",
            "npm ci",
            "npm --prefix yjs-server ci --omit=optional",
            "npm run build"
        ],
        "services": "docker compose up -d --wait --remove-orphans",
        "services:stop": "docker compose down --remove-orphans",
        "lint": "@php vendor/bin/pint",
        "lint:test": "@php vendor/bin/pint --test",
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@services",
            "@php artisan migrate --graceful",
            "npx concurrently -c \"#93c5fd,#86efac,#fdba74\" \"php artisan serve --no-reload --port=${APP_PORT:-8000}\" \"npm run dev -- --port ${VITE_PORT:-5173}\" \"npm --prefix yjs-server run dev\" --names=laravel,vite,yjs --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
